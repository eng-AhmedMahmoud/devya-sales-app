# Public config for devya-sales-app in production (no secrets here). deploy.sh
# exports it for `next build` (NEXT_PUBLIC_* are inlined into the browser
# bundle and the /api rewrite target is baked in at build time) and ships it
# to the VPS as the container's runtime env_file. Change a value: redeploy.
API_PROXY_TARGET="https://api.devya-solutions.com"
SESSION_COOKIE_NAME="devya_session"
NEXT_PUBLIC_API_URL="https://sales.devya-solutions.com"
NEXT_PUBLIC_ADMIN_URL="https://admin.devya-solutions.com"
NEXT_PUBLIC_BOOKING_URL="https://booking.devya.dev"
NEXT_PUBLIC_CONTRACTS_URL="https://contracts.devya-solutions.com"
NEXT_PUBLIC_TASKS_URL="https://tasks.devya-solutions.com"
NEXT_PUBLIC_SALES_CALENDAR_SLUG="business"
NEXT_PUBLIC_COMPANY_NAME="Devya Solutions"
NEXT_PUBLIC_COMPANY_URL="https://devya.dev"
